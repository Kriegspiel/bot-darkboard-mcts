[Unit]
Description=Kriegspiel Darkboard MCTS Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fil
WorkingDirectory=/home/fil/dev/kriegspiel/bot-darkboard-mcts
ExecStart=/home/fil/dev/kriegspiel/bot-darkboard-mcts/.venv/bin/python /home/fil/dev/kriegspiel/bot-darkboard-mcts/bot.py --poll-seconds 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
